# ============================================================
#  Versa – environment variable reference
#  Copy to .env and fill in your values before running.
# ============================================================

# --- PostgreSQL ---
# When running via Docker Compose the host is "postgres" (service name).
# For local dev outside Docker use "localhost".
DATABASE_URL=postgresql://versa:versa@postgres:5432/versa

# --- MinIO object storage ---
# MINIO_ENDPOINT: internal address used by the backend container.
# MINIO_PUBLIC_URL: browser-accessible address for generated download URLs.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_PDF=pdfs
MINIO_BUCKET_AUDIOBOOKS=audiobooks

# --- API / Security ---
PROJECT_NAME=Versatile
# Generate a strong random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# --- CORS ---
# Set to your frontend origin in production (e.g. https://app.example.com)
FRONTEND_URL=http://localhost
