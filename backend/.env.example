# Database (PostgreSQL)
DATABASE_URL=postgresql://versa:versa@localhost:5432/versa

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_PDF=pdfs
MINIO_BUCKET_AUDIOBOOKS=audiobooks

# API
PROJECT_NAME=Versatile
SECRET_KEY=your-secret-key-change-in-production

# CORS
FRONTEND_URL=http://localhost:5173

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 — optional; upload is silently skipped when absent.
# The refresh token must be obtained with the full youtube scope:
#   https://www.googleapis.com/auth/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=unlisted
YOUTUBE_CATEGORY_ID=22
